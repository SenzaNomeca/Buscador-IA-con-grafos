# PostgreSQL
DB_HOST=<host-postgres>
DB_PORT=9913
DB_NAME=generated_images
DB_USER=
DB_PASSWORD=
DB_SSL=false

# DigitalOcean Spaces (S3-compatible)
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_BUCKET=n8ns3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=sfo3

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Graph engine
# SEARCH_ENGINE=graph        # default: in-memory Graphology (sql = fallback PostgreSQL)
# GRAPH_REFRESH_MS=60000     # intervalo del refresh incremental (delta con watermark)
# GRAPH_FULL_RELOAD_MS=600000  # cada cuánto se hace rebuild completo (reconcilia deletes)

# Semantic search (requires Ollama local + image_embeddings table)
# SEARCH_MODE=lexical        # lexical | semantic | hybrid (lexical = default)
# EMBED_MODEL=bge-m3         # modelo en Ollama (fallback recomendado: nomic-embed-text)
# EMBED_SERVER=http://127.0.0.1:11434
# EMBED_DIM=1024             # must match the model: bge-m3=1024, nomic-embed-text=768
# SEMANTIC_MIN_SCORE=0.65    # solo filtra el feed semántico en hybrid

# Tramos de coincidencia de /api/search (porcentaje de metadatos)
# SEARCH_TIER_STRONG=80      # 80-100: Resultados parecidos (requiere cohesión)
# SEARCH_TIER_POSSIBLE=40    # 40-79: Podría encajar
# SEARCH_MATCH_FLOOR=10      # 10-39: Podrían ser similares; <10 se descarta
# Un match parcial multi-término solo entra si algún término es "distintivo":
# aparece en <= SEARCH_DISTINCTIVE_DF_RATIO del catálogo (mín. SEARCH_DISTINCTIVE_MIN_DF)
# SEARCH_DISTINCTIVE_DF_RATIO=0.01
# SEARCH_DISTINCTIVE_MIN_DF=10

# Modo archivo: usa el volcado de la API pública en vez de PostgreSQL/S3.
# Con esto el proyecto arranca sin credenciales y se actualiza solo.
DB_MOCK=true
DB_FILE=data/images.json

# Origen del volcado (no hace falta cambiarlo para el demo).
# DUMP_BASE=https://n8n.americana.edu.co/vorael
# DUMP_OUT=data/images.json
# SYNC_SAFETY_PAGES=2        # páginas 100% conocidas seguidas para cortar el sync incremental
# SYNC_FULL_MS=604800000     # (7d) full periódico; los resets/bajas se detectan antes

# Auto-sync del volcado dentro de la API (solo con DB_FILE; ver src/autoSync.ts)
AUTO_SYNC_MS=60000           # vuelca al arrancar y cada 60 s; 0 = apagado
AUTO_SYNC_ON_BOOT=true       # primer vuelco antes de cargar el grafo
